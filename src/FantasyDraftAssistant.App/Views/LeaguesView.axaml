<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FantasyDraftAssistant.App.ViewModels"
             x:Class="FantasyDraftAssistant.App.Views.LeaguesView"
             x:DataType="vm:LeaguesViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16">
      <TextBlock Text="Leagues" Classes="h1" />
      <TextBlock Text="Create a league or jump into a mock draft with the local seed player pool." Classes="muted" TextWrapping="Wrap" />

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Quick start" Classes="h2" />
          <Button Content="Start 12-team Superflex mock draft" Classes="primary" Command="{Binding StartMockDraftCommand}" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding StatusMessage}" Classes="muted" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="New league" Classes="h2" />
          <StackPanel Spacing="4">
            <TextBlock Text="League name" FontWeight="SemiBold" />
            <TextBox Text="{Binding NewLeagueName}"
                     ToolTip.Tip="Display name for the new league. Team count is 12 by default and can be reviewed on League Setup." />
            <Button Content="Create league" Classes="primary" Command="{Binding CreateLeagueCommand}"
                    HorizontalAlignment="Left" Margin="0,4,0,0" />
          </StackPanel>
          <CheckBox Content="Superflex / 2-QB (leave unchecked for a standard 1-QB league)"
                    IsChecked="{Binding NewLeagueSuperflex}" />
          <TextBlock Text="A 12-team standard league uses QB/2RB/2WR/TE/FLEX/K/DEF/6 BENCH and 15 rounds. Check Superflex only if QB is flex-eligible."
                     Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Leagues}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Margin="0,0,0,10">
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Bottom" Content="Open" Classes="ghost"
                        HorizontalAlignment="Left" Margin="0,10,0,0"
                        Command="{Binding $parent[ItemsControl].((vm:LeaguesViewModel)DataContext).OpenLeagueCommand}"
                        CommandParameter="{Binding}" />
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding Season, StringFormat='Season {0}'}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
