<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FantasyDraftAssistant.App.ViewModels"
             xmlns:views="using:FantasyDraftAssistant.App.Views"
             x:Class="FantasyDraftAssistant.App.Views.RecapView"
             x:DataType="vm:RecapViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16">
      <TextBlock Text="Post-Draft Recap" Classes="h1" />
      <TextBlock Text="Deterministic totals from the local cache. AI is optional and does not block this page."
                 Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />

      <Border Classes="card" IsVisible="{Binding !HasDraft}">
        <TextBlock Text="Open a league and start a draft first." Classes="muted" TextWrapping="Wrap" />
      </Border>

      <Border Classes="card" IsVisible="{Binding HasDraft}">
        <StackPanel Spacing="8">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Mark draft complete" Classes="primary"
                    IsVisible="{Binding CanComplete}"
                    Command="{Binding CompleteDraftCommand}" />
            <TextBlock Text="Summary" Classes="h2" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Summary}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding HasValue}">
        <StackPanel Spacing="8">
          <TextBlock Text="Your picks vs ADP" Classes="h2" />
          <TextBlock Text="Reach means earlier than consensus ADP. Value means later."
                     Classes="muted" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ValueLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Teams}" IsVisible="{Binding HasTeams}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RecapTeamBlock">
            <Border Classes="card" Margin="0,0,0,10">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Title}" Classes="h2" TextWrapping="Wrap">
                  <ToolTip.Tip>
                    <views:TeamPortraitTip TeamKey="{Binding TeamKey}" />
                  </ToolTip.Tip>
                </TextBlock>
                <TextBlock Text="{Binding Detail}" Classes="muted" />
                <ItemsControl ItemsSource="{Binding Players}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" Margin="0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button Content="Open Draft Room" Classes="ghost" HorizontalAlignment="Left"
              IsVisible="{Binding HasDraft}"
              Command="{Binding OpenRoomCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
