<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FantasyDraftAssistant.App.ViewModels"
             xmlns:views="using:FantasyDraftAssistant.App.Views"
             xmlns:ai="using:FantasyDraftAssistant.Core.Ai"
             x:Class="FantasyDraftAssistant.App.Views.LeagueSetupView"
             x:DataType="vm:LeagueSetupViewModel">
  <ScrollViewer x:Name="PageScroll"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Focusable="True"
                BringIntoViewOnFocusChange="False">
    <StackPanel Spacing="16">
      <TextBlock Text="League Setup" Classes="h1" />
      <TextBlock Text="{Binding StatusMessage}" Classes="muted" />
      <Border Classes="card">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="League name" FontWeight="SemiBold" />
            <TextBox Text="{Binding LeagueName}"
                     ToolTip.Tip="Display name for this league. It is not the number of teams or a scoring format." />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Season" FontWeight="SemiBold" />
            <TextBox Text="{Binding Season}"
                     ToolTip.Tip="NFL season year for this league, for example 2026." />
            <TextBlock Text="The NFL season this draft is for." Classes="muted" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Draft rounds" FontWeight="SemiBold" />
            <TextBox Text="{Binding RoundCount}"
                     ToolTip.Tip="How many rounds the draft lasts. This is not the number of teams. A 12-team standard roster is usually 15 rounds; Superflex is usually 16." />
            <TextBlock Text="How many picks each team makes. This is not the number of teams — that is the list below. IR is not a draft round. Standard 1-QB is usually 15; Superflex is usually 16."
                       Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Draft guidelines for AI" FontWeight="SemiBold" />
            <TextBlock Text="Plain-language notes the analysts should follow when advising YOUR picks in this league. They do not change the board or the CPU mock. A preset fills the box; edit it, then Save."
                       Classes="muted" TextWrapping="Wrap" />
            <WrapPanel Margin="0,0,0,4">
              <Button Content="House rules" Classes="ghost" Margin="0,0,8,8"
                      Command="{Binding ApplyGuidelinePresetCommand}"
                      CommandParameter="{Binding GuidelinePresets[0]}"
                      ToolTip.Tip="Wait on K/DEF and skip backup QB/TE unless the value is obvious." />
              <Button Content="Best available" Classes="ghost" Margin="0,0,8,8"
                      Command="{Binding ApplyGuidelinePresetCommand}"
                      CommandParameter="{Binding GuidelinePresets[1]}"
                      ToolTip.Tip="Take rank/ADP value. Do not reach far for need early." />
              <Button Content="Zero RB" Classes="ghost" Margin="0,0,8,8"
                      Command="{Binding ApplyGuidelinePresetCommand}"
                      CommandParameter="{Binding GuidelinePresets[2]}"
                      ToolTip.Tip="WR-heavy early. Wait on RB unless an elite one falls." />
              <Button Content="Hero RB" Classes="ghost" Margin="0,0,8,8"
                      Command="{Binding ApplyGuidelinePresetCommand}"
                      CommandParameter="{Binding GuidelinePresets[3]}"
                      ToolTip.Tip="One early RB, then WR. Do not take RB2 early." />
              <Button Content="RB first" Classes="ghost" Margin="0,0,8,8"
                      Command="{Binding ApplyGuidelinePresetCommand}"
                      CommandParameter="{Binding GuidelinePresets[4]}"
                      ToolTip.Tip="Secure two starting RBs early, then best available." />
              <Button Content="Late QB" Classes="ghost" Margin="0,0,8,8"
                      Command="{Binding ApplyGuidelinePresetCommand}"
                      CommandParameter="{Binding GuidelinePresets[5]}"
                      ToolTip.Tip="1-QB plan. Wait on quarterback unless an elite one falls." />
              <Button Content="Superflex QB" Classes="ghost" Margin="0,0,8,8"
                      Command="{Binding ApplyGuidelinePresetCommand}"
                      CommandParameter="{Binding GuidelinePresets[6]}"
                      ToolTip.Tip="Get a QB early and a second before the cliff." />
              <Button Content="TE premium" Classes="ghost" Margin="0,0,8,8"
                      Command="{Binding ApplyGuidelinePresetCommand}"
                      CommandParameter="{Binding GuidelinePresets[7]}"
                      ToolTip.Tip="Take a top TE near ADP instead of a replacement-level TE later." />
              <Button Content="Clear" Classes="ghost" Margin="0,0,8,8"
                      Command="{Binding ClearGuidelinesCommand}"
                      ToolTip.Tip="Empty the notes. Analysts then use no extra user rules." />
            </WrapPanel>
            <TextBox Text="{Binding DraftGuidelines}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="110"
                     PlaceholderText="Don't suggest a K or DEF until the last two rounds.&#x0a;Don't suggest a backup QB or TE unless the value is clearly too good to pass."
                     ToolTip.Tip="The analysts read this on every Ask. Example: wait on K/DEF; skip backup QB/TE unless the value is obvious." />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Web board slug" FontWeight="SemiBold" />
            <TextBox Text="{Binding WebSlug}"
                     PlaceholderText="filthymothers"
                     ToolTip.Tip="URL folder on kellynorton.com/draft/. Lowercase letters, numbers, and hyphens." />
            <CheckBox IsChecked="{Binding PublishBoard}"
                      Content="Publish this league's board to the web" />
            <TextBlock Text="{Binding BoardPublicUrl}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Roster" Classes="h2" />
          <TextBlock Text="Yahoo Fantasy slot types. Change the counts to match your league. Presets only fill these numbers."
                     Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding RosterSummary}" Classes="muted" TextWrapping="Wrap" />
          <WrapPanel Margin="0,4,0,8">
            <Button Content="Yahoo default" Classes="ghost" Command="{Binding ApplyYahooRosterCommand}" Margin="0,0,8,8" />
            <Button Content="Standard 1-QB" Classes="ghost" Command="{Binding ApplyStandardRosterCommand}" Margin="0,0,8,8" />
            <Button Content="Superflex" Classes="ghost" Command="{Binding ApplySuperflexRosterCommand}" Margin="0,0,8,8" />
            <Button Content="Match rounds to roster" Classes="ghost" Command="{Binding MatchRoundsToRosterCommand}" Margin="0,0,8,8" />
          </WrapPanel>
          <ItemsControl ItemsSource="{Binding Roster}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RosterSlotEditor">
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                  <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                      <Button Content="−" Classes="ghost" Command="{Binding DecrementCommand}" />
                      <TextBlock Text="{Binding Count}" Width="24" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                      <Button Content="+" Classes="ghost" Command="{Binding IncrementCommand}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{Binding YahooName}" FontWeight="SemiBold"
                                 ToolTip.Tip="{Binding DisplayName}" />
                      <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Eligibility}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Scoring" Classes="h2" />
          <TextBlock Text="Each box is the points awarded for that event. Scoring is saved as soon as you change a value. Hover a row for the unit (per yard, per catch, each FG, and so on). Yahoo's “10 yards per point” is Receiving yards = 0.10, not Reception / PPR. FantasyPros only has Standard / Half PPR / PPR sheets; refresh that cache after a scoring change so ranks match."
                     Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ScoringSummary}" Classes="muted" TextWrapping="Wrap" />
          <WrapPanel Margin="0,0,0,4">
            <Button Content="Standard" Classes="ghost" Command="{Binding ApplyStandardScoringCommand}" Margin="0,0,8,8" />
            <Button Content="Half PPR" Classes="ghost" Command="{Binding ApplyHalfPprScoringCommand}" Margin="0,0,8,8" />
            <Button Content="PPR" Classes="ghost" Command="{Binding ApplyPprScoringCommand}" Margin="0,0,8,8" />
          </WrapPanel>
          <ItemsControl ItemsSource="{Binding ScoringGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ScoringGroup">
                <StackPanel Margin="0,0,0,12" Spacing="6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ScoringRuleEditor">
                        <Grid ColumnDefinitions="*,100" ColumnSpacing="8" Margin="0,3">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Help}" Classes="muted" TextWrapping="Wrap" FontSize="11" />
                          </StackPanel>
                          <TextBox Grid.Column="1" Text="{Binding PointsText}"
                                   Classes.invalid="{Binding HasInvalidPoints}"
                                   ToolTip.Tip="{Binding Help}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Teams" Classes="h2" />
          <TextBlock Text="This list is the number of teams. The # box is the first-round seat — type 6 to move this team to pick 6. Drag the handle, or use the arrows. Save writes the new order. The About box is only for portraits. Art style is separate from roast vs Normal. Random (and New image) picks a new outfit, setting, and style each time. Hover a name for that team's image. Unchecked rivals get roasted; check Normal image for the same over-the-top hero treatment as you."
                     Classes="muted" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Generate team images" Classes="ghost"
                    Command="{Binding GenerateAllPortraitsCommand}"
                    IsEnabled="{Binding !IsGeneratingPortraits}"
                    ToolTip.Tip="Generate every team with the selected image AI. Honors each row's Normal image checkbox. Billed per image." />
            <TextBlock Text="Image AI" VerticalAlignment="Center" Classes="muted" />
            <ComboBox ItemsSource="{Binding PortraitProviders}"
                      SelectedItem="{Binding SelectedPortraitProvider}"
                      MinWidth="120" MaxWidth="160"
                      ToolTip.Tip="Grok Imagine or ChatGPT Images. Claude cannot generate pictures. Needs that provider's API key.">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PortraitAiOption">
                  <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <Grid ColumnDefinitions="20,48,56,200,140,120,56,Auto,Auto,*" ColumnSpacing="8">
            <TextBlock />
            <TextBlock Grid.Column="1" Text="#" Classes="muted" />
            <TextBlock Grid.Column="2" />
            <TextBlock Grid.Column="3" Text="Team name" Classes="muted" />
            <TextBlock Grid.Column="4" Text="Owner" Classes="muted" />
            <TextBlock Grid.Column="5" Text="CPU style" Classes="muted"
                       ToolTip.Tip="How this seat drafts when the CPU controls it in practice drafts. Random deals a personality each practice." />
            <TextBlock Grid.Column="6" Text="Normal" Classes="muted" />
          </Grid>
          <ItemsControl x:Name="TeamList" ItemsSource="{Binding Teams}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TeamRow">
                <StackPanel Margin="0,4,0,8" Spacing="4">
                  <Grid ColumnDefinitions="20,48,56,200,140,120,56,Auto,Auto,*" ColumnSpacing="8">
                    <TextBlock Text="≡" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center"
                               FontWeight="SemiBold" Cursor="SizeNorthSouth"
                               IsEnabled="{Binding $parent[ItemsControl].((vm:LeagueSetupViewModel)DataContext).CanReorderTeams}"
                               PointerPressed="OnSeatGripPressed"
                               ToolTip.Tip="Drag to change the first-round seat." />
                    <TextBox Grid.Column="1" Classes="seat" Text="{Binding SeatText}"
                             MinWidth="40" MaxWidth="48"
                             IsEnabled="{Binding $parent[ItemsControl].((vm:LeagueSetupViewModel)DataContext).CanReorderTeams}"
                             LostFocus="OnSeatCommit"
                             ToolTip.Tip="Round-1 seat. Type 6 and press Enter (or leave the box) to move this team to pick 6." />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                      <Button Content="↑" Classes="ghost compact"
                              IsEnabled="{Binding CanMoveUp}"
                              Command="{Binding $parent[ItemsControl].((vm:LeagueSetupViewModel)DataContext).MoveTeamUpCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Move this team one seat earlier." />
                      <Button Content="↓" Classes="ghost compact"
                              IsEnabled="{Binding CanMoveDown}"
                              Command="{Binding $parent[ItemsControl].((vm:LeagueSetupViewModel)DataContext).MoveTeamDownCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Move this team one seat later." />
                    </StackPanel>
                    <TextBox Grid.Column="3" Text="{Binding Name}" MaxWidth="200">
                      <ToolTip.Tip>
                        <views:TeamPortraitTip TeamKey="{Binding TeamKey}" />
                      </ToolTip.Tip>
                    </TextBox>
                    <TextBox Grid.Column="4" Text="{Binding OwnerName}" PlaceholderText="Owner" MaxWidth="140"
                             ToolTip.Tip="Person who owns this team. Optional." />
                    <ComboBox Grid.Column="5" MinWidth="110"
                              ItemsSource="{Binding PersonalityOptions}"
                              SelectedItem="{Binding SelectedPersonality}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Practice drafts only. How this seat drafts when the CPU controls it. Random deals a personality each practice; live drafts ignore this." />
                    <CheckBox Grid.Column="6" IsChecked="{Binding NormalImage}"
                              IsVisible="{Binding CanChoosePortraitStyle}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip.Tip="On: over-the-top handsome genius, same energy as your portrait. Off: the roast. Your team has no checkbox and always looks great." />
                    <Button Grid.Column="7" Content="New image" Classes="ghost compact"
                            Command="{Binding $parent[ItemsControl].((vm:LeagueSetupViewModel)DataContext).GenerateOnePortraitCommand}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding !IsGenerating}"
                            ToolTip.Tip="Generate a new portrait for this team only. Random style, outfit, and setting change each click." />
                    <Button Grid.Column="8" Content="Export" Classes="ghost compact"
                            Command="{Binding $parent[ItemsControl].((vm:LeagueSetupViewModel)DataContext).ExportPortraitCommand}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding HasPortrait}"
                            ToolTip.Tip="Save this team's image to a file you pick." />
                    <TextBlock Grid.Column="9" Text="{Binding PortraitStatus}" Classes="muted"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding PortraitStatus}" />
                  </Grid>
                  <Grid ColumnDefinitions="132,168,*" ColumnSpacing="8">
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ArtStyleOptions}"
                              SelectedItem="{Binding SelectedArtStyle}"
                              MinWidth="160"
                              ToolTip.Tip="Art style for this portrait. Random picks a new style, outfit, and setting each New image. Hero vs roast is still the Normal checkbox.">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="ai:PortraitArtStyle">
                          <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Grid.Column="2" Text="{Binding PortraitNotes}"
                             PlaceholderText="A little about this person for the portrait (age, look, vibe)"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             ToolTip.Tip="Used only when generating this team's image. Example: Black woman, late 30s, short hair, glasses." />
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Save" Classes="primary" Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save league name, draft guidelines, roster, scoring, and teams. Scoring also saves as you edit it." />
            <TextBlock Text="{Binding SaveNotice}" Classes="ready" VerticalAlignment="Center"
                       IsVisible="{Binding HasSaveNotice}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
