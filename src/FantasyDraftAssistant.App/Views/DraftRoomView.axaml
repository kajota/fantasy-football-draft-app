<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FantasyDraftAssistant.App.ViewModels"
             xmlns:views="using:FantasyDraftAssistant.App.Views"
             xmlns:controls="using:FantasyDraftAssistant.App.Controls"
             x:Class="FantasyDraftAssistant.App.Views.DraftRoomView"
             x:DataType="vm:DraftRoomViewModel"
             Focusable="True">
  <UserControl.Resources>
    <DataTemplate x:Key="SourceLabelTemplate" x:DataType="x:String">
      <TextBlock Text="{Binding}" Foreground="{StaticResource TextBrush}" />
    </DataTemplate>
    <DataTemplate x:Key="TauntTargetTemplate" x:DataType="vm:TauntTargetOption">
      <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}">
        <ToolTip.Tip>
          <views:TeamPortraitTip TeamKey="{Binding TeamKey}" />
        </ToolTip.Tip>
      </TextBlock>
    </DataTemplate>
    <DataTemplate x:Key="PlayerNameWithLinksTemplate" x:DataType="vm:PlayerRow">
      <StackPanel MinWidth="0" Spacing="1">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding HandcuffLabel}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}"
                   IsVisible="{Binding IsHandcuff}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding HandcuffDetail}" />
        <TextBlock Text="{Binding SharedByeLabel}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource DangerBrush}"
                   IsVisible="{Binding HasSharedBye}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding SharedByeDetail}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasExternalLinks}">
          <HyperlinkButton Content="FPros" NavigateUri="{Binding FantasyProsUri}"
                           IsVisible="{Binding HasFantasyProsLink}"
                           FontSize="11" Padding="0"
                           ToolTip.Tip="Open FantasyPros ranks, news, and outlook" />
          <HyperlinkButton Content="Sleep" NavigateUri="{Binding SleeperUri}"
                           IsVisible="{Binding HasSleeperLink}"
                           FontSize="11" Padding="0"
                           ToolTip.Tip="Open this player on Sleeper" />
          <HyperlinkButton Content="Yahoo" NavigateUri="{Binding YahooUri}"
                           IsVisible="{Binding HasYahooLink}"
                           FontSize="11" Padding="0"
                           ToolTip.Tip="Open this player on Yahoo" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="RosterSlotTemplate" x:DataType="vm:RosterSlotRow">
      <Border Margin="0,0,0,3" Padding="6,4" CornerRadius="3" Background="{Binding Fill}">
        <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="6" MinWidth="0">
          <TextBlock Text="{Binding SlotCode}" FontWeight="Bold" FontSize="11"
                     Foreground="{Binding Foreground}" VerticalAlignment="Center"
                     ToolTip.Tip="{Binding DisplayName}" />
          <TextBlock Grid.Column="1" Text="{Binding Player}" FontWeight="SemiBold" FontSize="12"
                     Foreground="{Binding Foreground}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11"
                     Foreground="{Binding Foreground}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="AnalystTileTemplate" x:DataType="vm:AiAnalystPanel">
      <Border Classes="card" Padding="10" Margin="4" MinWidth="180" MinHeight="160">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Classes="muted" />
            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IncludeInAsk}"
                      IsEnabled="{Binding Enabled}" Margin="0,0,6,0"
                      ToolTip.Tip="Include this analyst when you Ask or Auto-ask." />
            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Heading}" />
          </DockPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <controls:AiResponseText Segments="{Binding Segments}" FontSize="13" TextWrapping="Wrap"
                                     MentionCommand="{Binding $parent[UserControl].((vm:DraftRoomViewModel)DataContext).ShowMentionedPlayerCommand}"
                                     ToolTip.Tip="Highlighted names are players. Click one to find them on Available Players." />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,*" RowSpacing="8">

    <Border Classes="card" Padding="14,10" ClipToBounds="True">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                    Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Content="Undo" Classes="ghost"
                  IsEnabled="{Binding CanUndo}"
                  Command="{Binding RollbackLastCommand}"
                  ToolTip.Tip="Undo the last pick. Ctrl+Z. Keepers stay put." />
          <Button Content="Redo" Classes="ghost"
                  IsEnabled="{Binding CanRedo}"
                  Command="{Binding RedoCommand}"
                  ToolTip.Tip="Redo the last undo. Ctrl+Y. A new pick clears this." />
          <Button Content="{Binding ResetLabel}" Classes="danger"
                  IsEnabled="{Binding CanReset}"
                  Command="{Binding ResetBoardCommand}"
                  ToolTip.Tip="Clear every pick on this board back to the first pick. Keepers stay. Click twice to confirm, and Undo puts it all back." />
        </StackPanel>
        <Border DockPanel.Dock="Left" Width="76" Height="76" Margin="0,0,14,0"
                CornerRadius="6" ClipToBounds="True"
                Background="{StaticResource ElevatedBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                IsVisible="{Binding HasCurrentTeamPortrait}">
          <Image Source="{Binding CurrentTeamPortrait}" Stretch="UniformToFill">
            <ToolTip.Tip>
              <views:TeamPortraitTip TeamKey="{Binding SelectingTeamKey}" />
            </ToolTip.Tip>
          </Image>
        </Border>
	        <StackPanel Spacing="2" MinWidth="0">
          <TextBlock Text="CURRENT PICK" FontSize="11" LetterSpacing="1" Classes="muted" />
          <TextBlock Text="{Binding LocationLine}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
            <Run Classes="muted" Text="On the clock: " />
            <Run Text="{Binding RoundPick}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
            <Run Text="    " />
            <Run Classes="muted" Text="Selecting: " />
            <InlineUIContainer>
              <TextBlock Text="{Binding SelectingTeam}" FontWeight="Bold">
                <ToolTip.Tip>
                  <views:TeamPortraitTip TeamKey="{Binding SelectingTeamKey}" />
                </ToolTip.Tip>
              </TextBlock>
            </InlineUIContainer>
            <Run Text="    " />
            <Run Text="{Binding UserNext}" />
          </TextBlock>
          <Border Margin="0,8,0,0" Padding="10,7" CornerRadius="4"
                  Background="#3A1820" BorderBrush="#6B2A35" BorderThickness="1"
                  IsVisible="{Binding HasDataSourceWarning}">
            <TextBlock Text="{Binding DataSourceWarning}" Classes="danger"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
          </Border>
          <DockPanel Margin="0,8,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
              <Button Content="Practice from here" Classes="ghost"
                      IsVisible="{Binding HasDraft}"
                      IsEnabled="{Binding !IsMockPlaying}"
                      Command="{Binding PracticeFromHereCommand}"
                      ToolTip.Tip="Start a new practice from the live draft's current pick. Keepers stay. Does not change the real board." />
              <Button Content="Live draft" Classes="ghost"
                      IsVisible="{Binding CanReturnToLive}"
                      IsEnabled="{Binding !IsMockPlaying}"
                      Command="{Binding ReturnToLiveCommand}"
                      ToolTip.Tip="Leave this practice branch and return to the real draft. Practice picks stay saved on the practice timeline." />
              <Button Content="{Binding PlayMockLabel}" Classes="primary"
                      IsVisible="{Binding HasMockSession}"
                      IsEnabled="{Binding CanPlayMock}"
                      Command="{Binding PlayMockCommand}"
                      ToolTip.Tip="CPU seats pick from rankings and their personality. Stops on your pick, or finishes the board if you have no pick left." />
              <Button Content="Step" Classes="ghost"
                      IsVisible="{Binding HasMockSession}"
                      IsEnabled="{Binding CanPlayMock}"
                      Command="{Binding StepMockCommand}"
                      ToolTip.Tip="Make the next CPU pick only." />
              <Button Content="Pause" Classes="ghost"
                      IsVisible="{Binding IsMockPlaying}"
                      Command="{Binding PauseMockCommand}"
                      ToolTip.Tip="Stop after the current CPU pick." />
            </StackPanel>
            <TextBlock Text="{Binding MockStatusLine}" Classes="muted" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasMockSession}" />
          </DockPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="Overview">
        <!-- Star row plus pixel row, so the splitter between them can move real height around. -->
        <Grid RowDefinitions="*,6,250" Margin="0,4,0,0">
          <Grid ColumnDefinitions="*,6,1.4*">
            <Border Classes="card" Padding="10" ClipToBounds="True" MinWidth="0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Draft list" Classes="h2" Margin="0,0,0,6" />
                <ListBox x:Name="BoardList" ItemsSource="{Binding Board}"
                         SelectedItem="{Binding CurrentBoardRow}"
                         Background="Transparent" FontSize="12">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BoardRow">
                      <Panel>
                        <Border IsVisible="{Binding IsCurrent}" Background="#33E8A317" CornerRadius="3" />
                        <Grid ColumnDefinitions="16,50,*,*" MinWidth="0" Margin="2,1">
                          <TextBlock Text="{Binding Marker}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                          <TextBlock Grid.Column="1" Text="{Binding RoundPick}" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="2" Text="{Binding Team}" TextTrimming="CharacterEllipsis">
                            <ToolTip.Tip>
                              <views:TeamPortraitTip TeamKey="{Binding TeamKey}" />
                            </ToolTip.Tip>
                          </TextBlock>
                          <TextBlock Grid.Column="3" Text="{Binding Player}" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding ReasonTip}" />
                        </Grid>
                      </Panel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Classes="pane" ResizeDirection="Columns" />

            <Border Grid.Column="2" Classes="card" Padding="10" ClipToBounds="True" MinWidth="0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
                  <TextBlock Text="Available players" Classes="h2" />
                  <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                      <Button Content="Draft" Classes="primary" Command="{Binding DraftSelectedCommand}"
                              ToolTip.Tip="Give the highlighted player to the team on the clock." />
                      <Button Content="Queue" Classes="ghost" Command="{Binding QueueSelectedCommand}"
                              ToolTip.Tip="Save this player on My Queue. Does not draft them." />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,72,*" ColumnSpacing="6" MinWidth="0">
                      <TextBox x:Name="SearchBox" Text="{Binding Search}" MinWidth="0"
                               PlaceholderText="Search players"
                               ToolTip.Tip="Filter players by name. Press / when you are not typing in another box.">
                        <TextBox.InnerRightContent>
                          <Button Content="✕" Classes="ghost compact" Padding="6,0" Margin="0,0,2,0"
                                  IsVisible="{Binding HasSearch}"
                                  Command="{Binding ClearSearchCommand}"
                                  ToolTip.Tip="Clear the search and show the full board. Esc also clears." />
                        </TextBox.InnerRightContent>
                      </TextBox>
                      <ComboBox Grid.Column="1" ItemsSource="{Binding Positions}" SelectedItem="{Binding PositionFilter}"
                                MinWidth="0"
                                ItemTemplate="{StaticResource SourceLabelTemplate}" />
                      <ComboBox Grid.Column="2" ItemsSource="{Binding DataSources}" SelectedItem="{Binding DataSource}"
                                IsVisible="{Binding HasMultipleSources}"
                                MinWidth="0" HorizontalAlignment="Stretch"
                                ItemTemplate="{StaticResource SourceLabelTemplate}"
                                ToolTip.Tip="Which cached ranks, ADP, and projections to show. This does not call the network." />
                    </Grid>
                  </DockPanel>
                  <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="32,*,28,36,36,48,44" MinWidth="0">
                    <Button Content="{Binding RankHeader}" Classes="column"
                            Command="{Binding SortAvailableCommand}" CommandParameter="Rank" />
                    <Button Grid.Column="1" Content="{Binding NameHeader}" Classes="column"
                            Command="{Binding SortAvailableCommand}" CommandParameter="Name" />
                    <TextBlock Grid.Column="2" Text="St" Classes="muted" FontSize="11"
                               ToolTip.Tip="Sleeper injury/status from the last refresh. Blank means Active." />
                    <Button Grid.Column="3" Content="{Binding PositionHeader}" Classes="column"
                            Command="{Binding SortAvailableCommand}" CommandParameter="Position" />
                    <Button Grid.Column="4" Content="{Binding NflHeader}" Classes="column"
                            Command="{Binding SortAvailableCommand}" CommandParameter="NflTeam" />
                    <Button Grid.Column="5" Content="{Binding AdpHeader}" Classes="column"
                            Command="{Binding SortAvailableCommand}" CommandParameter="Adp" />
                    <Button Grid.Column="6" Content="{Binding ProjHeader}" Classes="column"
                            Command="{Binding SortAvailableCommand}" CommandParameter="ProjectedPoints" />
                  </Grid>
                </StackPanel>
                <ListBox ItemsSource="{Binding Available}" SelectedItem="{Binding SelectedPlayer}" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlayerRow">
                      <Border Background="{Binding HandcuffFill}" CornerRadius="3" Padding="0,1">
                      <Grid ColumnDefinitions="32,*,28,36,36,48,44" MinWidth="0">
                        <TextBlock Text="{Binding Rank}" Classes="muted" VerticalAlignment="Center" />
                        <ContentControl Grid.Column="1" Content="{Binding}"
                                        ContentTemplate="{StaticResource PlayerNameWithLinksTemplate}" />
                        <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Classes="danger" FontWeight="SemiBold"
                                   ToolTip.Tip="{Binding InjuryDetail}" />
                        <TextBlock Grid.Column="3" Text="{Binding Position}" />
                        <TextBlock Grid.Column="4" Text="{Binding NflTeam}" Classes="muted" />
                        <TextBlock Grid.Column="5" Text="{Binding Adp}" />
                        <TextBlock Grid.Column="6" Text="{Binding ProjLabel}" />
                      </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </Grid>

          <GridSplitter Grid.Row="1" Classes="pane" ResizeDirection="Rows"
                        IsVisible="{Binding HasDecisionBoard}" />

          <Border Grid.Row="2" Classes="card" Padding="12,10" ClipToBounds="True"
                  IsVisible="{Binding HasDecisionBoard}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Spacing="1" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding NextPickLine}" FontWeight="SemiBold" FontSize="12"
                             Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding InterveningHeading}" Classes="muted" FontSize="11"
                             HorizontalAlignment="Right" IsVisible="{Binding HasInterveningTeams}" />
                </StackPanel>
                <StackPanel Spacing="1" MinWidth="0">
                  <TextBlock Text="Best available by position" Classes="h2" />
                  <TextBlock Text="The top player left at each position, and whether they last until your next pick. Click one to find them on Available Players."
                             Classes="muted" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>

              <ItemsControl ItemsSource="{Binding BestByPosition}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PositionBestRow">
                    <Button Classes="ghost" Margin="0,0,6,0" Padding="8,6"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding $parent[ItemsControl].((vm:DraftRoomViewModel)DataContext).ShowPositionBestCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Best value left at this position. Click to find them on Available Players.">
                      <StackPanel Spacing="1" MinWidth="0">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding ParLabel}" FontWeight="Bold"
                                     Foreground="{Binding ParBrush}" FontSize="13"
                                     ToolTip.Tip="{Binding ParTip}" />
                          <TextBlock Text="{Binding Position}" FontWeight="Bold" FontSize="11"
                                     Foreground="{StaticResource MutedBrush}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                        <TextBlock Text="{Binding OutlookLabel}" FontSize="11" IsVisible="{Binding HasOutlook}"
                                   Foreground="{Binding OutlookBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding OutlookTip}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel Spacing="2" IsVisible="{Binding HasTierCliffs}" MinWidth="0">
                  <TextBlock Text="Tier cliffs" FontWeight="SemiBold" FontSize="11"
                             Foreground="{StaticResource MutedBrush}"
                             ToolTip.Tip="Positions where the next drop in quality is close." />
                  <ItemsControl ItemsSource="{Binding TierCliffLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,1"
                                   Foreground="{StaticResource TextBrush}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2" IsVisible="{Binding HasInterveningTeams}" MinWidth="0">
                  <TextBlock Text="Picking before you · likely targets" FontWeight="SemiBold" FontSize="11"
                             Foreground="{StaticResource MutedBrush}"
                             ToolTip.Tip="Teams on the clock between now and your next pick. The player shown is a guess from the same policy the practice-draft CPUs use — good about which positions are under pressure, often wrong about the exact name." />
                  <ItemsControl ItemsSource="{Binding InterveningLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:UpcomingPickRow">
                        <Grid ColumnDefinitions="34,Auto,*" ColumnSpacing="8" Margin="0,1" MinWidth="0">
                          <TextBlock Text="{Binding RoundPick}" FontSize="11" Classes="muted" />
                          <TextBlock Grid.Column="1" Text="{Binding TeamName}" FontSize="11"
                                     TextTrimming="CharacterEllipsis" MaxWidth="220"
                                     Foreground="{StaticResource TextBrush}" />
                          <TextBlock Grid.Column="2" Text="{Binding Predicted}" FontSize="11"
                                     IsVisible="{Binding HasPrediction}"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Draft List">
        <Border Classes="card" Padding="10" Margin="0,4,0,0" ClipToBounds="True">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Every pick in order, with the current slot highlighted."
                       Classes="muted" Margin="0,0,0,8" TextWrapping="Wrap" />
            <ListBox x:Name="BoardTabList" ItemsSource="{Binding Board}"
                     SelectedItem="{Binding CurrentBoardRow}"
                     Background="Transparent" FontSize="13">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BoardRow">
                  <Panel>
                    <Border IsVisible="{Binding IsCurrent}" Background="#33E8A317" CornerRadius="3" />
                    <Grid ColumnDefinitions="20,70,*,80,*" MinWidth="0" Margin="4,3">
                      <TextBlock Text="{Binding Marker}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                      <TextBlock Grid.Column="1" Text="{Binding RoundPick}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Text="{Binding Team}" TextTrimming="CharacterEllipsis">
                        <ToolTip.Tip>
                          <views:TeamPortraitTip TeamKey="{Binding TeamKey}" />
                        </ToolTip.Tip>
                      </TextBlock>
                      <TextBlock Grid.Column="3" Text="{Binding Position}" Classes="muted" />
                      <TextBlock Grid.Column="4" Text="{Binding Player}" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding ReasonTip}" />
                    </Grid>
                  </Panel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </TabItem>

      <TabItem Header="Draft Board">
        <Border Classes="card" Padding="8" Margin="0,4,0,0" ClipToBounds="True">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="4">
              <TextBlock Text="Teams across the top, rounds down the side. Your team is gold. The current pick has a gold border. Value colors a pick by ADP: green went later than expected (steal), red went earlier (reach)."
                         Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <CheckBox Content="Value (ADP)" IsChecked="{Binding BoardValueHeat}"
                          ToolTip.Tip="Color filled cells by steal vs reach versus ADP. Off uses position colors." />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowPositionLegend}">
                  <TextBlock Text="QB" Classes="board-swatch qb" />
                  <TextBlock Text="RB" Classes="board-swatch rb" />
                  <TextBlock Text="WR" Classes="board-swatch wr" />
                  <TextBlock Text="TE" Classes="board-swatch te" />
                  <TextBlock Text="K" Classes="board-swatch k" />
                  <TextBlock Text="DEF" Classes="board-swatch def" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowValueLegend}">
                  <TextBlock Text="Steal" Classes="board-swatch steal" />
                  <TextBlock Text="Slight steal" Classes="board-swatch mild-steal" />
                  <TextBlock Text="Fair" Classes="board-swatch fair" />
                  <TextBlock Text="Slight reach" Classes="board-swatch mild-reach" />
                  <TextBlock Text="Reach" Classes="board-swatch reach" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="36" Height="36" Margin="1" Background="#1B5E20" CornerRadius="3" />
                  <ItemsControl ItemsSource="{Binding BoardTeams}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DraftBoardTeamHeader">
                        <Border Width="112" Height="36" Margin="1" Padding="4,2" CornerRadius="3"
                                Background="{Binding Fill}">
                          <ToolTip.Tip>
                            <views:TeamPortraitTip TeamKey="{Binding TeamKey}" />
                          </ToolTip.Tip>
                          <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}"
                                     FontWeight="SemiBold" FontSize="11" TextAlignment="Center"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding BoardRounds}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DraftBoardRoundRow">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="48" Margin="1" Background="#1B5E20" CornerRadius="3">
                          <TextBlock Text="{Binding Round}" Foreground="#F4FFF4" FontWeight="Bold"
                                     FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Cells}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DraftBoardCell">
                              <Border Width="112" Height="48" Margin="1" Padding="4,3" CornerRadius="3"
                                      Background="{Binding Fill}" BorderBrush="{Binding Border}"
                                      BorderThickness="{Binding BorderThickness}"
                                      ToolTip.Tip="{Binding Tooltip}">
                                <TextBlock Text="{Binding Player}" Foreground="{Binding Foreground}"
                                           FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </TabItem>

      <TabItem Header="Available Players">
        <Border Classes="card" Padding="10" Margin="0,4,0,0" ClipToBounds="True">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
              <TextBlock Text="Full available list. Rank, ADP, and projections come from the selected cache — switching sources re-sorts this list."
                         Classes="muted" TextWrapping="Wrap" />
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                  <Button Content="Draft" Classes="primary" Command="{Binding DraftSelectedCommand}" />
                  <Button Content="Queue" Classes="ghost" Command="{Binding QueueSelectedCommand}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,80,*" ColumnSpacing="6" MinWidth="0">
                  <TextBox x:Name="SearchBoxTab" Text="{Binding Search}" PlaceholderText="Search players" MinWidth="0">
                    <TextBox.InnerRightContent>
                      <Button Content="✕" Classes="ghost compact" Padding="6,0" Margin="0,0,2,0"
                              IsVisible="{Binding HasSearch}"
                              Command="{Binding ClearSearchCommand}"
                              ToolTip.Tip="Clear the search and show the full board. Esc also clears." />
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Positions}" SelectedItem="{Binding PositionFilter}"
                            MinWidth="0"
                            ItemTemplate="{StaticResource SourceLabelTemplate}" />
                  <ComboBox Grid.Column="2" ItemsSource="{Binding DataSources}" SelectedItem="{Binding DataSource}"
                            IsVisible="{Binding HasMultipleSources}"
                            MinWidth="0" HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource SourceLabelTemplate}" />
                </Grid>
              </DockPanel>
              <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="40,*,36,50,50,60,60,50" MinWidth="0">
                <Button Content="{Binding RankHeader}" Classes="column" Command="{Binding SortAvailableCommand}" CommandParameter="Rank" />
                <Button Grid.Column="1" Content="{Binding NameHeader}" Classes="column" Command="{Binding SortAvailableCommand}" CommandParameter="Name" />
                <TextBlock Grid.Column="2" Text="St" Classes="muted" FontSize="11"
                           ToolTip.Tip="Sleeper injury/status from the last refresh. Blank means Active. Hover a player for notes." />
                <Button Grid.Column="3" Content="{Binding PositionHeader}" Classes="column" Command="{Binding SortAvailableCommand}" CommandParameter="Position" />
                <Button Grid.Column="4" Content="{Binding NflHeader}" Classes="column" Command="{Binding SortAvailableCommand}" CommandParameter="NflTeam" />
                <Button Grid.Column="5" Content="{Binding AdpHeader}" Classes="column" Command="{Binding SortAvailableCommand}" CommandParameter="Adp" />
                <Button Grid.Column="6" Content="{Binding ProjHeader}" Classes="column" Command="{Binding SortAvailableCommand}" CommandParameter="ProjectedPoints" />
                <TextBlock Grid.Column="7" Text="Tier" Classes="muted" FontSize="11" />
              </Grid>
            </StackPanel>
            <ListBox ItemsSource="{Binding Available}" SelectedItem="{Binding SelectedPlayer}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PlayerRow">
                  <Border Background="{Binding HandcuffFill}" CornerRadius="3" Padding="0,1">
                  <Grid ColumnDefinitions="40,*,36,50,50,60,60,50" MinWidth="0">
                    <TextBlock Text="{Binding Rank}" Classes="muted" VerticalAlignment="Center" />
                    <ContentControl Grid.Column="1" Content="{Binding}"
                                    ContentTemplate="{StaticResource PlayerNameWithLinksTemplate}" />
                    <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Classes="danger" FontWeight="SemiBold"
                               ToolTip.Tip="{Binding InjuryDetail}" />
                    <TextBlock Grid.Column="3" Text="{Binding Position}" />
                    <TextBlock Grid.Column="4" Text="{Binding NflTeam}" Classes="muted" />
                    <TextBlock Grid.Column="5" Text="{Binding Adp}" />
                    <TextBlock Grid.Column="6" Text="{Binding ProjLabel}" />
                    <TextBlock Grid.Column="7" Text="{Binding Tier}" Classes="muted" />
                  </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </TabItem>

      <TabItem Header="My Queue">
        <Border Classes="card" Padding="10" Margin="0,4,0,0" ClipToBounds="True">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Draft first" Classes="primary"
                        IsVisible="{Binding !QueueEmpty}"
                        Command="{Binding DraftQueueCommand}" />
                <TextBlock Text="Queued players, in order. More queue tools can land here later."
                           Classes="muted" TextWrapping="Wrap" />
              </DockPanel>
            </StackPanel>
            <TextBlock Text="Empty — queue a player from Available."
                       Classes="muted" IsVisible="{Binding QueueEmpty}" />
            <ListBox ItemsSource="{Binding Queue}" Background="Transparent" IsVisible="{Binding !QueueEmpty}" FontSize="13">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PlayerRow">
                  <Grid ColumnDefinitions="28,*,50,36,36,36" ColumnSpacing="8" MinWidth="0" Margin="0,4">
                    <TextBlock Text="{Binding Rank}" Classes="muted" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding SharedByeLabel}" Classes="danger" FontSize="11"
                                 IsVisible="{Binding HasSharedBye}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding SharedByeDetail}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Position}" Classes="muted" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="↑" Classes="ghost compact"
                            IsEnabled="{Binding CanMoveUp}"
                            Command="{Binding $parent[ListBox].((vm:DraftRoomViewModel)DataContext).MoveQueuedUpCommand}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Column="4" Content="↓" Classes="ghost compact"
                            IsEnabled="{Binding CanMoveDown}"
                            Command="{Binding $parent[ListBox].((vm:DraftRoomViewModel)DataContext).MoveQueuedDownCommand}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Column="5" Content="×" Classes="ghost compact"
                            Command="{Binding $parent[ListBox].((vm:DraftRoomViewModel)DataContext).RemoveQueuedCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </TabItem>

      <TabItem Header="Roster">
        <Border Classes="card" Padding="10" Margin="0,4,0,0" ClipToBounds="True">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="6">
              <TextBlock Text="Starting slots first, then flex, bench, and IR. Players land in the tightest slot that fits. Empty starters are needs. Empty bench and IR are open, not needs."
                         Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Spacing="6" IsVisible="{Binding HasRosterBoard}">
                  <Border Width="140" Height="140" CornerRadius="8" ClipToBounds="True"
                          Background="{StaticResource ElevatedBrush}"
                          IsVisible="{Binding HasSelectedRosterPortrait}">
                    <Image Source="{Binding SelectedRosterPortrait}" Stretch="UniformToFill" />
                  </Border>
                  <Button Content="Import image" Classes="ghost compact" HorizontalAlignment="Stretch"
                          Command="{Binding ImportSelectedRosterPortraitCommand}"
                          ToolTip.Tip="Use your own JPEG, PNG, or WebP for this team. Replaces a generated image." />
                  <Button Content="Export image" Classes="ghost compact" HorizontalAlignment="Stretch"
                          Command="{Binding ExportSelectedRosterPortraitCommand}"
                          IsVisible="{Binding HasSelectedRosterPortrait}"
                          ToolTip.Tip="Save this team's image to a file you pick." />
                </StackPanel>
                <StackPanel Spacing="6" VerticalAlignment="Center">
                  <ComboBox ItemsSource="{Binding RosterTeams}" SelectedItem="{Binding SelectedRosterTeam}"
                            IsVisible="{Binding HasMultipleRosterTeams}"
                            MinWidth="180"
                            ItemTemplate="{StaticResource TauntTargetTemplate}">
                    <ToolTip.Tip>
                      <views:TeamPortraitTip TeamKey="{Binding SelectedRosterTeam.TeamKey}" />
                    </ToolTip.Tip>
                  </ComboBox>
                  <TextBlock Text="{Binding RosterNeedsLine}" FontWeight="SemiBold" IsVisible="{Binding HasRosterBoard}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <TextBlock Text="Open a draft to see slot needs."
                       Classes="muted" IsVisible="{Binding !HasRosterBoard}" />
            <ScrollViewer IsVisible="{Binding HasRosterBoard}">
              <ItemsControl ItemsSource="{Binding Roster}" ItemTemplate="{StaticResource RosterSlotTemplate}" />
            </ScrollViewer>
          </DockPanel>
        </Border>
      </TabItem>

      <TabItem Header="AI Analysts">
        <DockPanel Margin="0,4,0,0">
          <Border DockPanel.Dock="Top" Classes="card" Padding="8" Margin="0,0,0,6">
            <StackPanel Spacing="6">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                  <Button Content="Side by side" Classes="ghost compact" Command="{Binding TileAiSideBySideCommand}"
                          ToolTip.Tip="Give each provider a column." />
                  <Button Content="Stacked" Classes="ghost compact" Command="{Binding TileAiStackedCommand}"
                          ToolTip.Tip="Stack each provider in a row." />
                </StackPanel>
                <TextBlock Text="{Binding AiContextLine}" Classes="muted" TextWrapping="Wrap" FontSize="11"
                           VerticalAlignment="Center" />
              </DockPanel>
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" x:Name="AiPromptBoxTab" Text="{Binding AiPrompt}" Height="40"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         PlaceholderText="Who should the person drafting now pick?" />
                <Button Grid.Column="1" Content="Fast" Classes="ghost" Command="{Binding UseFastAiCommand}"
                        VerticalAlignment="Stretch"
                        ToolTip.Tip="Short answer from the current snapshot. Use on the clock." />
                <Button Grid.Column="2" Content="Deep" Classes="ghost" Command="{Binding UseDeepAiCommand}"
                        VerticalAlignment="Stretch"
                        ToolTip.Tip="Same snapshot, longer look. Slower and costs more." />
                <Button Grid.Column="3" Content="Ask" Classes="primary" Command="{Binding AskAiCommand}"
                        VerticalAlignment="Stretch"
                        ToolTip.Tip="Empty box asks who the person on the clock should pick, not who you should take." />
              </Grid>
              <DockPanel>
                <CheckBox DockPanel.Dock="Left" Content="Auto-ask when I'm on the clock" IsChecked="{Binding AutoAskEnabled}"
                          ToolTip.Tip="Off until you check it. Opening Draft Room does not spend. When on, Fast/Deep advisors are asked automatically when it becomes your pick." />
                <TextBlock Text="{Binding AiModeHint}" Classes="muted" TextWrapping="Wrap" FontSize="11"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Alerts}" IsVisible="{Binding HasAlerts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" Classes="accent" FontSize="11" TextWrapping="Wrap" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Grid>
            <ItemsControl ItemsSource="{Binding Analysts}" IsVisible="{Binding AiTileHorizontal}"
                          ItemTemplate="{StaticResource AnalystTileTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Analysts}" IsVisible="{Binding AiTileVertical}"
                          ItemTemplate="{StaticResource AnalystTileTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="AI History">
        <Border Classes="card" Padding="10" Margin="0,4,0,0" ClipToBounds="True">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Export Markdown" Classes="ghost"
                      IsEnabled="{Binding CanExportAiHistory}"
                      Command="{Binding ExportAiHistoryCommand}"
                      ToolTip.Tip="Save this draft branch's AI prompts and responses to a Markdown file, along with any AI-drafted seat's picks and reasons." />
              <StackPanel Spacing="2" MinWidth="0">
                <TextBlock Text="AI History" Classes="h2" />
                <TextBlock Text="Saved prompts and responses for this draft branch, newest first."
                           Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
            <TextBlock Text="No AI recommendations have been saved for this draft branch."
                       Classes="muted" IsVisible="{Binding !HasAiHistory}" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasAiHistory}">
              <ItemsControl ItemsSource="{Binding AiHistory}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AiHistoryRow">
                    <Border Classes="card" Padding="10" Margin="0,0,0,10">
                      <StackPanel Spacing="8">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}"
                                     Classes="muted" FontSize="11" />
                          <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                     TextWrapping="Wrap" />
                        </DockPanel>
                        <StackPanel Spacing="3">
                          <TextBlock Text="Prompt" Classes="muted" FontSize="11" />
                          <TextBox Text="{Binding Prompt}" IsReadOnly="True"
                                   AcceptsReturn="True" TextWrapping="Wrap"
                                   MinHeight="42" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                          <TextBlock Text="Response" Classes="muted" FontSize="11" />
                          <TextBox Text="{Binding Response}" IsReadOnly="True"
                                   AcceptsReturn="True" TextWrapping="Wrap"
                                   MinHeight="120" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
