<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FantasyDraftAssistant.App.ViewModels"
             x:Class="FantasyDraftAssistant.App.Views.DataSourcesView"
             x:DataType="vm:DataSourcesViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16">
      <TextBlock Text="Player Data" Classes="h1" />
      <TextBlock Text="The Draft Room reads this local cache, not the network. FantasyPros ranks/ADP use the closest sheet to the open league (Standard / Half PPR / PPR, 1-QB or Superflex). Projections are re-scored with that league's exact rules. The seed pack stays available if you are offline."
                 Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />

      <ItemsControl ItemsSource="{Binding Providers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FantasyDataProviderRow">
            <Border Classes="card" Margin="0,0,0,10">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Title}" Classes="h2" />
                <TextBlock Text="{Binding LastSynced}" Classes="muted" TextWrapping="Wrap"
                           ToolTip.Tip="{Binding $parent[ItemsControl].((vm:DataSourcesViewModel)DataContext).CacheTimeZoneNote}" />
                <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
                <StackPanel Spacing="6" IsVisible="{Binding NeedsApiKey}">
                  <TextBlock Text="API key" FontWeight="SemiBold" />
                  <TextBox Text="{Binding ApiKey}" PasswordChar="•"
                           ToolTip.Tip="FantasyPros public API key. Leave blank to keep a key that is already saved." />
                  <TextBlock IsVisible="{Binding KeySaved}"
                             Text="A FantasyPros key is already saved."
                             Classes="muted" />
                  <Button Content="Save key" Classes="ghost" HorizontalAlignment="Left"
                          Command="{Binding $parent[ItemsControl].((vm:DataSourcesViewModel)DataContext).SaveKeyCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
                <Button Content="Refresh into local cache" Classes="primary" HorizontalAlignment="Left"
                        Command="{Binding $parent[ItemsControl].((vm:DataSourcesViewModel)DataContext).RefreshProviderCommand}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Web draft board" Classes="h2" />
          <TextBlock Text="After each pick the app PUTs board.json to this URL plus the league slug. The token is the same bearer value as /etc/nginx/draft-token.map. Enable publishing per league on League Setup."
                     Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="Base URL" FontWeight="SemiBold" />
          <TextBox Text="{Binding BoardBaseUrl}"
                   ToolTip.Tip="Default is https://kellynorton.com/draft. Do not include the league slug." />
          <TextBlock Text="Bearer token" FontWeight="SemiBold" />
          <TextBox Text="{Binding BoardToken}" PasswordChar="•"
                   ToolTip.Tip="Leave blank to keep a token that is already saved." />
          <TextBlock IsVisible="{Binding BoardTokenSaved}"
                     Text="A publish token is already saved."
                     Classes="muted" />
          <TextBlock Text="{Binding BoardPublishStatus}" Classes="muted" TextWrapping="Wrap" />
          <WrapPanel>
            <Button Content="Save board settings" Classes="ghost" Margin="0,0,8,8"
                    Command="{Binding SaveBoardPublishCommand}" />
            <Button Content="Publish now" Classes="ghost" Margin="0,0,8,8"
                    Command="{Binding PublishBoardNowCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Cache contents" Classes="h2" />
          <TextBlock Text="{Binding CacheTimeZoneNote}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
