<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FantasyDraftAssistant.App.ViewModels"
             x:Class="FantasyDraftAssistant.App.Views.DraftOrderView"
             x:DataType="vm:DraftOrderViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <TextBlock Text="Draft Order" Classes="h1" />
      <TextBlock Text="{Binding StatusMessage}" Classes="muted" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Create draft" Classes="primary" Command="{Binding CreateDraftCommand}" />
        <Button Content="Start draft" Classes="ghost" Command="{Binding StartCommand}" />
      </StackPanel>
    </StackPanel>
    <ListBox ItemsSource="{Binding Slots}" Margin="0,16,0,0" Background="Transparent" />
  </DockPanel>
</UserControl>
