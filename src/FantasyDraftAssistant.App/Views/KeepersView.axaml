<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FantasyDraftAssistant.App.ViewModels"
             xmlns:views="using:FantasyDraftAssistant.App.Views"
             x:Class="FantasyDraftAssistant.App.Views.KeepersView"
             x:DataType="vm:KeepersViewModel">
  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">
        <TextBlock Text="Keepers" Classes="h1" />
        <TextBlock Text="One keeper per team. A keeper uses that team's pick in the chosen round and cannot be drafted by anyone else. You can still assign them after a draft starts if you undo every regular pick first."
                   Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />

        <Border Classes="card" IsVisible="{Binding !HasLeague}">
          <TextBlock Text="Select or create a league first." Classes="muted" />
        </Border>

        <Border Classes="card" IsVisible="{Binding ShowCreateDraft}">
          <StackPanel Spacing="10">
            <TextBlock Text="No draft yet" Classes="h2" />
            <TextBlock Text="Keepers belong to a draft so they can consume a real slot. Create the draft, assign keepers, then start it from Draft Order."
                       Classes="muted" TextWrapping="Wrap" />
            <Button Content="Create draft" Classes="primary" HorizontalAlignment="Left"
                    Command="{Binding CreateDraftCommand}" />
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding HasDraft}">
          <StackPanel Spacing="12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Load players" Classes="ghost"
                        IsVisible="{Binding CanEdit}"
                        Command="{Binding LoadPlayersCommand}" />
                <Button Content="New draft" Classes="ghost"
                        IsVisible="{Binding ShowLocked}"
                        Command="{Binding CreateDraftCommand}"
                        ToolTip.Tip="Starts a fresh unstarted draft on this league so you can assign keepers." />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Assignments" Classes="h2" />
                <TextBlock Text="{Binding Summary}" Classes="muted" />
              </StackPanel>
            </DockPanel>

            <Border IsVisible="{Binding ShowLocked}" Background="#33E8A317" CornerRadius="6" Padding="10">
              <TextBlock Text="Keepers lock once regular picks are on the board. Undo every non-keeper pick in the Draft Room to change them here, or use New draft."
                         TextWrapping="Wrap" />
            </Border>

            <Border IsVisible="{Binding ShowReopened}" Background="#3322C55E" CornerRadius="6" Padding="10">
              <TextBlock Text="No regular picks are on this draft yet, so keepers can still be assigned. Save to put them on the board, then return to the Draft Room."
                         TextWrapping="Wrap" />
            </Border>

            <Grid ColumnDefinitions="160,*,56,72,Auto" ColumnSpacing="8">
              <TextBlock Text="Team" Classes="muted" />
              <TextBlock Grid.Column="1" Text="Player" Classes="muted" />
              <TextBlock Grid.Column="2" Text="Round" Classes="muted" />
              <TextBlock Grid.Column="3" Text="Slot" Classes="muted" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Teams}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeeperTeamRow">
                  <Grid ColumnDefinitions="160,*,56,72,Auto" ColumnSpacing="8" Margin="0,6">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding TeamName}" FontWeight="SemiBold" TextWrapping="Wrap">
                        <ToolTip.Tip>
                          <views:TeamPortraitTip TeamKey="{Binding TeamKey}" />
                        </ToolTip.Tip>
                      </TextBlock>
                      <TextBlock Text="{Binding OwnerName}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding PlayerName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding PlayerDetail}" Classes="muted" />
                      <TextBox Text="{Binding Notes}" Margin="0,4,0,0"
                               PlaceholderText="Notes"
                               IsEnabled="{Binding $parent[UserControl].((vm:KeepersViewModel)DataContext).CanEdit}"
                               ToolTip.Tip="Optional note, for example the Yahoo round." />
                    </StackPanel>
                    <TextBox Grid.Column="2" Text="{Binding RoundCostText}" VerticalAlignment="Center"
                             Classes.invalid="{Binding HasInvalidRound}"
                             IsEnabled="{Binding $parent[UserControl].((vm:KeepersViewModel)DataContext).CanEdit}"
                             ToolTip.Tip="The draft round this keeper costs. Use a whole number such as 4, not 4.3." />
                    <TextBlock Grid.Column="3" Text="{Binding SlotLabel}" VerticalAlignment="Center"
                               Classes.danger="{Binding HasInvalidRound}" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding $parent[UserControl].((vm:KeepersViewModel)DataContext).CanEdit}">
                      <Button Content="Assign" Classes="primary compact"
                              Command="{Binding $parent[UserControl].((vm:KeepersViewModel)DataContext).BeginAssignCommand}"
                              CommandParameter="{Binding}" />
                      <Button Content="Clear" Classes="ghost compact"
                              Command="{Binding $parent[UserControl].((vm:KeepersViewModel)DataContext).ClearKeeperCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Save keepers" Classes="primary" HorizontalAlignment="Left"
                    IsVisible="{Binding CanEdit}"
                    Command="{Binding SaveCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border IsVisible="{Binding ShowPicker}"
            Background="#CC0B1220"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ZIndex="10">
      <Border Classes="card" MaxWidth="560" MaxHeight="640" Margin="24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
            <TextBlock Text="{Binding PickerTitle}" Classes="h2" TextWrapping="Wrap" />
            <TextBox Text="{Binding Search}"
                     PlaceholderText="Search name, team, or position"
                     ToolTip.Tip="Filter the local player cache. Type at least part of the name." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Use this player" Classes="primary"
                      Command="{Binding ConfirmPickCommand}" />
              <Button Content="Cancel" Classes="ghost"
                      Command="{Binding CancelAssignCommand}" />
            </StackPanel>
          </StackPanel>
          <ListBox ItemsSource="{Binding PlayerChoices}"
                   SelectedItem="{Binding SelectedChoice}"
                   Background="Transparent"
                   DoubleTapped="OnPlayerDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:KeeperPlayerChoice">
                <StackPanel Margin="0,4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Detail}" Classes="muted" />
                  <TextBlock Text="{Binding TakenBy, StringFormat='Already kept by {0}'}"
                             Foreground="{StaticResource DangerBrush}"
                             IsVisible="{Binding !IsAvailable}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
