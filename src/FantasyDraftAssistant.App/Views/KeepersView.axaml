<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FantasyDraftAssistant.App.ViewModels"
             xmlns:views="using:FantasyDraftAssistant.App.Views"
             x:Class="FantasyDraftAssistant.App.Views.KeepersView"
             x:DataType="vm:KeepersViewModel">
  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">
        <TextBlock Text="Keepers" Classes="h1" />
        <TextBlock Text="One keeper per team. Assign them before the draft starts. A keeper uses that team's pick in the chosen round and cannot be drafted by anyone else."
                   Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />

        <Border Classes="card" IsVisible="{Binding !HasLeague}">
          <TextBlock Text="Select or create a league first." Classes="muted" />
        </Border>

        <Border Classes="card" IsVisible="{Binding ShowCreateDraft}">
          <StackPanel Spacing="10">
            <TextBlock Text="No draft yet" Classes="h2" />
            <TextBlock Text="Keepers belong to a draft so they can consume a real slot. Create the draft, assign keepers, then start it from Draft Order."
                       Classes="muted" TextWrapping="Wrap" />
            <Button Content="Create draft" Classes="primary" HorizontalAlignment="Left"
                    Command="{Binding CreateDraftCommand}" />
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding HasDraft}">
          <StackPanel Spacing="12">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Load players" Classes="ghost"
                      IsVisible="{Binding !HasPlayers}"
                      Command="{Binding LoadPlayersCommand}" />
              <StackPanel>
                <TextBlock Text="Assignments" Classes="h2" />
                <TextBlock Text="{Binding Summary}" Classes="muted" />
              </StackPanel>
            </DockPanel>

            <Grid ColumnDefinitions="*,1.4*,70,120,*,Auto" ColumnSpacing="8">
              <TextBlock Text="Team" Classes="muted" />
              <TextBlock Grid.Column="1" Text="Player" Classes="muted" />
              <TextBlock Grid.Column="2" Text="Round" Classes="muted" />
              <TextBlock Grid.Column="3" Text="Slot" Classes="muted" />
              <TextBlock Grid.Column="4" Text="Notes" Classes="muted" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Teams}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeeperTeamRow">
                  <Grid ColumnDefinitions="*,1.4*,70,120,*,Auto" ColumnSpacing="8" Margin="0,6">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding TeamName}" FontWeight="SemiBold" TextWrapping="Wrap">
                        <ToolTip.Tip>
                          <views:TeamPortraitTip TeamKey="{Binding TeamKey}" />
                        </ToolTip.Tip>
                      </TextBlock>
                      <TextBlock Text="{Binding OwnerName}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding PlayerName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding PlayerDetail}" Classes="muted" />
                    </StackPanel>
                    <TextBox Grid.Column="2" Text="{Binding RoundCostText}" VerticalAlignment="Center"
                             Classes.invalid="{Binding HasInvalidRound}"
                             IsEnabled="{Binding $parent[ItemsControl].((vm:KeepersViewModel)DataContext).CanEdit}"
                             ToolTip.Tip="The draft round this keeper costs. Use a whole number such as 4, not 4.3." />
                    <TextBlock Grid.Column="3" Text="{Binding SlotLabel}" VerticalAlignment="Center"
                               Classes.danger="{Binding HasInvalidRound}" />
                    <TextBox Grid.Column="4" Text="{Binding Notes}" VerticalAlignment="Center"
                             IsEnabled="{Binding $parent[ItemsControl].((vm:KeepersViewModel)DataContext).CanEdit}"
                             ToolTip.Tip="Optional note, for example the Yahoo round or a reminder." />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding $parent[ItemsControl].((vm:KeepersViewModel)DataContext).CanEdit}">
                      <Button Content="Assign" Classes="ghost"
                              Command="{Binding $parent[ItemsControl].((vm:KeepersViewModel)DataContext).BeginAssignCommand}"
                              CommandParameter="{Binding}" />
                      <Button Content="Clear" Classes="ghost"
                              Command="{Binding $parent[ItemsControl].((vm:KeepersViewModel)DataContext).ClearKeeperCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Save keepers" Classes="primary" HorizontalAlignment="Left"
                    IsVisible="{Binding CanEdit}"
                    Command="{Binding SaveCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border IsVisible="{Binding ShowPicker}"
            Background="#CC0B1220"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ZIndex="10">
      <Border Classes="card" MaxWidth="560" MaxHeight="640" Margin="24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
            <TextBlock Text="{Binding PickerTitle}" Classes="h2" TextWrapping="Wrap" />
            <TextBox Text="{Binding Search}"
                     PlaceholderText="Search name, team, or position"
                     ToolTip.Tip="Filter the local player cache." />
            <Button Content="Cancel" Classes="ghost" HorizontalAlignment="Left"
                    Command="{Binding CancelAssignCommand}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding PlayerChoices}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:KeeperPlayerChoice">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Classes="ghost" Margin="0,0,0,6"
                        Command="{Binding $parent[ListBox].((vm:KeepersViewModel)DataContext).PickPlayerCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding IsAvailable}">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" />
                    <TextBlock Text="{Binding TakenBy, StringFormat='Already kept by {0}'}"
                               Foreground="{StaticResource DangerBrush}"
                               IsVisible="{Binding !IsAvailable}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
