<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FantasyDraftAssistant.App.ViewModels"
        x:Class="FantasyDraftAssistant.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Fantasy Draft Assistant"
        Width="1440" Height="900"
        MinWidth="800" MinHeight="600"
        Background="{StaticResource BgBrush}">
  <DockPanel>
    <Border DockPanel.Dock="Left" Width="220" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="16,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,20">
          <TextBlock Text="FANTASY DRAFT" FontSize="11" LetterSpacing="1.4" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="Assistant" Classes="h2" />
          <TextBlock Text="{Binding Session.LeagueName, FallbackValue='No league selected'}" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel Spacing="4">
          <Button Content="Leagues" Classes="nav" Command="{Binding GoLeaguesCommand}" />
          <Button Content="League Setup" Classes="nav" Command="{Binding GoSetupCommand}" />
          <Button Content="Draft Order" Classes="nav" Command="{Binding GoOrderCommand}" />
          <Button Content="Keepers" Classes="nav" Command="{Binding GoKeepersCommand}" />
          <Button Content="Player Data" Classes="nav" Command="{Binding GoDataCommand}" />
          <Button Content="AI Providers" Classes="nav" Command="{Binding GoAiCommand}" />
          <Button Content="Readiness" Classes="nav" Command="{Binding GoReadyCommand}" />
          <Button Content="Draft Room" Classes="nav" Command="{Binding GoRoomCommand}" />
          <Button Content="History" Classes="nav" Command="{Binding GoHistoryCommand}" />
          <Button Content="Branches" Classes="nav" Command="{Binding GoBranchesCommand}" />
          <Button Content="Post-Draft Recap" Classes="nav" Command="{Binding GoRecapCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <ContentControl Content="{Binding CurrentPage}" Margin="16"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                    ClipToBounds="True" />
  </DockPanel>
</Window>
